# OpsHub API configuration (12-factor). Copy to .env for local development.
# Every variable is documented in internal/config/config.go.

# development | test | production
OPSHUB_ENV=development
OPSHUB_HTTP_ADDR=:8080
# Public URL of the web UI (used in emails, OAuth redirects, webhook URLs).
OPSHUB_PUBLIC_URL=http://localhost:5173
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For (e.g. your ingress).
# Empty: the TCP peer is the client IP and proxy headers are ignored.
OPSHUB_TRUSTED_PROXIES=

# debug | info | warn | error
OPSHUB_LOG_LEVEL=info
# json | text (defaults to json when OPSHUB_ENV=production)
OPSHUB_LOG_FORMAT=text

# Host port docker-compose publishes PostgreSQL on (change if 5432 is taken locally).
OPSHUB_PG_PORT=5432
OPSHUB_DATABASE_URL=postgres://opshub:opshub@localhost:${OPSHUB_PG_PORT}/opshub?sslmode=disable
OPSHUB_DB_MAX_CONNS=20
# Apply pending migrations at startup. Disable if you run `make migrate-up` in a deploy step.
OPSHUB_MIGRATE_ON_START=true
OPSHUB_SHUTDOWN_TIMEOUT=20s

# en | km — fallback when neither the user profile nor Accept-Language matches.
OPSHUB_DEFAULT_LOCALE=en
OPSHUB_DEFAULT_TIMEZONE=Asia/Phnom_Penh

# OpenTelemetry tracing is enabled when this is set (standard OTEL_* vars apply).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
