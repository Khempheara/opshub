# OpsHub configuration (12-factor). `make .env` copies this file to .env and generates
# the key rings. Every variable is documented in internal/config/config.go.

# ── Runtime ─────────────────────────────────────────────────────────────
# development | test | production
OPSHUB_ENV=development
OPSHUB_HTTP_ADDR=:8080
# Public URL of the web UI (email links, SSO callbacks, CSRF origin check). https in production.
OPSHUB_PUBLIC_URL=http://localhost:5173
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For (e.g. your ingress).
# Empty: the TCP peer is the client IP and proxy headers are ignored.
OPSHUB_TRUSTED_PROXIES=
# Extra browser origins allowed to call the API (CORS). Empty: same-origin only (recommended).
OPSHUB_CORS_ALLOWED_ORIGINS=
# debug | info | warn | error
OPSHUB_LOG_LEVEL=info
# json | text (defaults to json when OPSHUB_ENV=production)
OPSHUB_LOG_FORMAT=text

# ── Database ─────────────────────────────────────────────────────────────
# Host port docker-compose publishes PostgreSQL on (change if 5432 is taken locally).
OPSHUB_PG_PORT=5432
# The API connects as the DML-only role; migrations run as the schema owner
# (roles are created by deploy/compose/postgres/init-roles.sql).
OPSHUB_DATABASE_URL=postgres://opshub_app:opshub_app@localhost:${OPSHUB_PG_PORT}/opshub?sslmode=disable
OPSHUB_MIGRATE_DATABASE_URL=postgres://opshub_migrator:opshub_migrator@localhost:${OPSHUB_PG_PORT}/opshub?sslmode=disable
OPSHUB_DB_MAX_CONNS=20
# Apply pending migrations at startup. Disable in production and run `opshub-api migrate up`
# as a separate deploy step (Helm pre-upgrade job) with the migrator credentials.
OPSHUB_MIGRATE_ON_START=true
OPSHUB_SHUTDOWN_TIMEOUT=20s

# ── Keys (generated by `make .env` / `opshub-api keys generate`) ─────────
# "id:base64(32 bytes)" entries, comma-separated; the first key is active, the rest are kept
# for decryption/verification during rotation (after adding a master key, run
# `opshub-api keys rotate`, then drop the old one). Never commit real values.
OPSHUB_MASTER_KEYS=
OPSHUB_JWT_KEYS=

# ── Sign-up & accounts ───────────────────────────────────────────────────
OPSHUB_ALLOW_SIGNUP=true
# This address can always register and becomes platform admin.
OPSHUB_BOOTSTRAP_ADMIN_EMAIL=
# Per client IP (anonymous) / per user or token (authenticated).
OPSHUB_RATE_LIMIT_RPS=20
OPSHUB_RATE_LIMIT_BURST=40
# Per IP, per minute: sign-in attempts, and requests that send email or consume one-time
# tokens. (Account lockout additionally stops password guessing per account.)
OPSHUB_AUTH_LOGIN_PER_MINUTE=10
OPSHUB_AUTH_EMAIL_PER_MINUTE=5
# Outbound requests to user-supplied hosts (self-hosted GitLab / GitHub Enterprise, deploy
# targets, certificate checks of domain assets) can't reach private, loopback or link-local
# addresses (SSRF protection) except these CIDRs/addresses.
OPSHUB_OUTBOUND_ALLOWED_CIDRS=

# ── Email (Mailpit in development: http://localhost:8025) ────────────────
OPSHUB_SMTP_HOST=localhost
OPSHUB_SMTP_PORT=1025
OPSHUB_SMTP_USERNAME=
OPSHUB_SMTP_PASSWORD=
OPSHUB_SMTP_FROM=OpsHub <noreply@opshub.local>
# none (dev only) | starttls | tls
OPSHUB_SMTP_TLS=none

# ── Single sign-on (a provider is enabled when its client ID is set) ─────
# Callback URL to register with the provider: ${OPSHUB_PUBLIC_URL}/api/v1/auth/sso/<provider>/callback
OPSHUB_SSO_GITHUB_CLIENT_ID=
OPSHUB_SSO_GITHUB_CLIENT_SECRET=
OPSHUB_SSO_GOOGLE_CLIENT_ID=
OPSHUB_SSO_GOOGLE_CLIENT_SECRET=
OPSHUB_SSO_KEYCLOAK_ISSUER=
OPSHUB_SSO_KEYCLOAK_CLIENT_ID=
OPSHUB_SSO_KEYCLOAK_CLIENT_SECRET=

# ── Runners, artifacts and cache (Module 5) ─────────────────────────────
# Where the API stores artifact and cache archives.
OPSHUB_BLOB_DIR=data/blobs
# OPSHUB_ARTIFACT_MAX_BYTES=104857600         # per job (100 MiB)
# OPSHUB_CACHE_MAX_BYTES=524288000            # per cache entry (500 MiB)
# OPSHUB_CACHE_PROJECT_QUOTA_BYTES=2147483648 # per project; least recently used entries go first
# OPSHUB_SOURCE_MAX_BYTES=524288000           # per source checkout

# `make runner`: a local runner using this machine's Docker. Create a registration token in
# Organization → Runners and paste it here (needed only for the first start).
OPSHUB_RUNNER_REGISTRATION_TOKEN=
# Group id owning /var/run/docker.sock (0 on Docker Desktop; `stat -c %g /var/run/docker.sock` on Linux).
OPSHUB_DOCKER_GID=0

# ── Deployments (Module 6) ───────────────────────────────────────────────
# Deploy targets on private networks must be listed in OPSHUB_OUTBOUND_ALLOWED_CIDRS.
# Allow Docker targets that use the API host's own socket (root-equivalent on that host):
# OPSHUB_DEPLOY_LOCAL_DOCKER=false

# ── Observability ────────────────────────────────────────────────────────
# OpenTelemetry tracing is enabled when this is set (standard OTEL_* vars apply).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Local ports for `make dev` (docker compose) ──────────────────────────
OPSHUB_WEB_PORT=3000
OPSHUB_API_PORT=8080
OPSHUB_MAILPIT_PORT=8025
OPSHUB_PROMETHEUS_PORT=9090
OPSHUB_GRAFANA_PORT=3001
# Public URL of the compose web container (used for links in emails sent by the compose API).
OPSHUB_COMPOSE_PUBLIC_URL=http://localhost:3000
